# Never commit real API keys. V0.4 reads credentials only from environment variables.
# Binance USD-M Futures Demo/Testnet credentials:
BINANCE_TESTNET_API_KEY=your_testnet_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_secret_here

# Optional: use a different pair for spot testnet later.
BINANCE_SPOT_TESTNET_API_KEY=your_spot_testnet_key_here
BINANCE_SPOT_TESTNET_API_SECRET=your_spot_testnet_secret_here

# Optional webhook for local/Demo alerts. Keep disabled in config unless needed.
BTCQ_ALERT_WEBHOOK_URL=https://example.invalid/webhook

# V2.0 read-only live shadow mode. These keys should NOT have trading permission.
BINANCE_LIVE_READONLY_API_KEY=
BINANCE_LIVE_READONLY_API_SECRET=
