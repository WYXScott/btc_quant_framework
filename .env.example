# Never commit real API keys. The default workflow uses OKX public market data
# plus local SQLite paper trading and does not require private API keys.

# Optional OKX demo/read-only credentials for future private adapters or
# read-only shadow inspection. Keep trading permissions disabled unless a
# dedicated adapter has been implemented and reviewed.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# V2.0+ read-only live shadow mode. These keys should NOT have trading permission.
OKX_LIVE_READONLY_API_KEY=
OKX_LIVE_READONLY_API_SECRET=
OKX_LIVE_READONLY_API_PASSPHRASE=

# Optional webhook for local/demo alerts. Keep disabled in config unless needed.
BTCQ_ALERT_WEBHOOK_URL=https://example.invalid/webhook
